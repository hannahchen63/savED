{
  "manifest_version": 3,
  "name": "savED",
  "version": "1.2.2",
  "description": "Blurs Instagram posts and YouTube and TikTok videos that may be triggering during eating disorder recovery. Prototype, not medical advice.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5001/*"
  ],
  "action": {
    "default_title": "Gentle Feed",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://www.youtube.com/*",
        "https://www.tiktok.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}