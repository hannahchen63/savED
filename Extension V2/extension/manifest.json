{
  "manifest_version": 3,
  "name": "Gentle Feed",
  "version": "0.1.0",
  "description": "Blurs Instagram posts that may be triggering during eating disorder recovery. Prototype, not medical advice.",
  "permissions": [],
  "host_permissions": ["http://localhost:5000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
