{
  "manifest_version": 3,
  "name": "Feed Filter",
  "version": "0.1.0",
  "description": "Blurs feed posts flagged by a classifier, with a 'Show anyway' option.",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}